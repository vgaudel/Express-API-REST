# Copiez ce fichier vers `.env` (ignoré par git) puis adaptez les valeurs.

# Port d'écoute du serveur
PORT=3000

# Clé secrète qui SIGNE les tokens JWT. Longue, aléatoire, jamais commitée.
# Générer une valeur : node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=remplacez-moi-par-une-longue-valeur-aleatoire

# Durée de vie d'un token (15m, 1h, 7d...)
JWT_EXPIRES_IN=1h
